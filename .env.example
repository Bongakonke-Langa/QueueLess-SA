# Local development database (matches docker-compose.yml).
# For Neon/Supabase, replace both with the strings they give you:
#   DATABASE_URL = the POOLED connection  (Neon: host contains "-pooler")
#   DIRECT_URL   = the DIRECT connection  (migrations cannot run through a pooler)
# With a pooler, append the Prisma params, e.g.
#   ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://queueless:queueless@localhost:5432/queueless?schema=public"
DIRECT_URL="postgresql://queueless:queueless@localhost:5432/queueless?schema=public"

# "1" enables the demo affordances: the OTP code is returned in the API
# response and the Staff console shows the demo controls.
NEXT_PUBLIC_DEMO_MODE="1"
